# Copy to .env and fill in real values. Spring Boot doesn't auto-load .env files -
# export these as real environment variables before running (see README).

MONGODB_URI=mongodb://localhost:27017/car_leaderboard
REDIS_HOST=localhost
REDIS_PORT=6379
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080
